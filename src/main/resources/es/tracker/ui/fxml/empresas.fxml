<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="pantalla" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="es.tracker.ui.controlador.EmpresasControlador">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="titulo-pantalla" text="Empresas"/>
                        <Label fx:id="lblResumen" styleClass="subtitulo" text="0 empresas"/>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#onNueva" styleClass="primario" text="+ Nueva empresa"/>
            </children>
        </HBox>

        <HBox spacing="18.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tblEmpresas" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colNombre" prefWidth="170.0" text="Nombre"/>
                                <TableColumn fx:id="colSector" prefWidth="150.0" text="Sector"/>
                                <TableColumn fx:id="colWeb" prefWidth="200.0" text="Web"/>
                                <TableColumn fx:id="colOfertas" prefWidth="80.0" text="Ofertas"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#onEditar" styleClass="secundario" text="Editar"/>
                                <Button fx:id="btnBorrar" mnemonicParsing="false" onAction="#onBorrar" styleClass="peligro" text="Borrar"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox maxHeight="-Infinity" prefWidth="320.0" spacing="6.0" styleClass="tarjeta">
                    <children>
                        <Label fx:id="lblTituloFormulario" styleClass="titulo-tarjeta" text="Nueva empresa"/>
                        <Label styleClass="etiqueta-campo" text="Nombre *"/>
                        <TextField fx:id="txtNombre" accessibleText="Nombre de la empresa" promptText="Ej.: Indra"/>
                        <Label styleClass="etiqueta-campo" text="Sector *"/>
                        <ComboBox fx:id="cmbSector" accessibleText="Sector" editable="true" maxWidth="Infinity" promptText="Elige o escribe un sector"/>
                        <Label styleClass="etiqueta-campo" text="Web"/>
                        <TextField fx:id="txtWeb" accessibleText="Web de la empresa" promptText="https://..."/>
                        <Label styleClass="etiqueta-campo" text="Fecha de registro *"/>
                        <DatePicker fx:id="dpFechaRegistro" accessibleText="Fecha de registro" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
                        <Label styleClass="nota-pie" text="Los campos con * son obligatorios."/>
                        <Label fx:id="lblError" styleClass="texto-error" wrapText="true"/>
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button cancelButton="true" mnemonicParsing="false" onAction="#onCancelar" styleClass="secundario" text="Cancelar"/>
                                <Button fx:id="btnGuardar" defaultButton="true" mnemonicParsing="false" onAction="#onGuardar" styleClass="primario" text="Guardar empresa"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
