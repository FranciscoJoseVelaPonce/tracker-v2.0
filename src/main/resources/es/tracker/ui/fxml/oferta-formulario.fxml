<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="es.tracker.ui.controlador.OfertaFormularioControlador">
    <content>
        <VBox styleClass="pantalla">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button accessibleText="Volver sin guardar" mnemonicParsing="false" onAction="#onCancelar" styleClass="secundario" text="←">
                            <tooltip>
                                <Tooltip text="Volver sin guardar"/>
                            </tooltip>
                        </Button>
                        <VBox spacing="4.0">
                            <children>
                                <Label fx:id="lblTitulo" styleClass="titulo-pantalla" text="Nueva candidatura"/>
                                <Label styleClass="subtitulo" text="Rellena los datos de la oferta a la que te has presentado"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="12.0" styleClass="tarjeta">
                    <children>
                        <GridPane hgap="18.0" vgap="6.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                            </columnConstraints>
                            <children>
                                <Label styleClass="etiqueta-campo" text="Título *"/>
                                <Label styleClass="etiqueta-campo" text="Empresa *" GridPane.columnIndex="1"/>
                                <TextField fx:id="txtTitulo" accessibleText="Título de la oferta" promptText="Ej.: Desarrollador Java Junior" GridPane.rowIndex="1"/>
                                <ComboBox fx:id="cmbEmpresa" accessibleText="Empresa" maxWidth="Infinity" promptText="Elige una empresa" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label styleClass="etiqueta-campo" text="Estado *" GridPane.rowIndex="2"/>
                                <Label styleClass="etiqueta-campo" text="Fecha de postulación *" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                <ComboBox fx:id="cmbEstado" accessibleText="Estado" maxWidth="Infinity" GridPane.rowIndex="3"/>
                                <DatePicker fx:id="dpFecha" accessibleText="Fecha de postulación" maxWidth="Infinity" promptText="dd/mm/aaaa" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                                <Label styleClass="etiqueta-campo" text="Enlace de la oferta" GridPane.rowIndex="4"/>
                                <Label styleClass="etiqueta-campo" text="Salario anual (opcional)" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                                <TextField fx:id="txtEnlace" accessibleText="Enlace de la oferta" promptText="https://..." GridPane.rowIndex="5"/>
                                <TextField fx:id="txtSalario" accessibleText="Salario anual" promptText="Ej.: 22.000" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                                <Label styleClass="etiqueta-campo" text="Descripción" GridPane.rowIndex="6"/>
                                <TextArea fx:id="txtDescripcion" accessibleText="Descripción de la oferta" prefRowCount="3" promptText="Funciones, requisitos, tecnologías..." wrapText="true" GridPane.columnSpan="2" GridPane.rowIndex="7"/>

                                <Label styleClass="etiqueta-campo" text="Notas" GridPane.rowIndex="8"/>
                                <TextArea fx:id="txtNotas" accessibleText="Notas personales" prefRowCount="2" promptText="Cómo te enteraste de la oferta, contactos..." wrapText="true" GridPane.columnSpan="2" GridPane.rowIndex="9"/>
                            </children>
                        </GridPane>
                        <Label styleClass="nota-pie" text="Los campos con * son obligatorios."/>
                        <Label fx:id="lblError" styleClass="texto-error" wrapText="true"/>
                        <HBox spacing="10.0">
                            <children>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button cancelButton="true" mnemonicParsing="false" onAction="#onCancelar" styleClass="secundario" text="Cancelar"/>
                                <Button fx:id="btnGuardar" defaultButton="true" mnemonicParsing="false" onAction="#onGuardar" styleClass="primario" text="Guardar candidatura"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
