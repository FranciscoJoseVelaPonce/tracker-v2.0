<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="380.0" spacing="6.0" styleClass="pantalla" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="es.tracker.ui.controlador.EntrevistaDialogoControlador">
    <children>
        <Label fx:id="lblTitulo" styleClass="titulo-tarjeta" text="Nueva entrevista"/>
        <Label fx:id="lblOferta" styleClass="subtitulo" wrapText="true"/>
        <Label styleClass="etiqueta-campo" text="Fecha *"/>
        <DatePicker fx:id="dpFecha" accessibleText="Fecha de la entrevista" maxWidth="Infinity" promptText="dd/mm/aaaa"/>
        <Label styleClass="etiqueta-campo" text="Tipo *"/>
        <ComboBox fx:id="cmbTipo" accessibleText="Tipo de entrevista" maxWidth="Infinity" promptText="Elige el tipo"/>
        <Label styleClass="etiqueta-campo" text="Resultado *"/>
        <ComboBox fx:id="cmbResultado" accessibleText="Resultado" maxWidth="Infinity"/>
        <Label styleClass="etiqueta-campo" text="Notas"/>
        <TextArea fx:id="txtNotas" accessibleText="Notas de la entrevista" prefRowCount="3" wrapText="true"/>
        <Label fx:id="lblError" styleClass="texto-error" wrapText="true"/>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button cancelButton="true" mnemonicParsing="false" onAction="#onCancelar" styleClass="secundario" text="Cancelar"/>
                <Button fx:id="btnGuardar" defaultButton="true" mnemonicParsing="false" onAction="#onGuardar" styleClass="primario" text="Guardar entrevista"/>
            </children>
        </HBox>
    </children>
</VBox>
