<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="es.tracker.ui.controlador.OfertaDetalleControlador">
    <content>
        <VBox styleClass="pantalla">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button accessibleText="Volver al listado" mnemonicParsing="false" onAction="#onVolver" styleClass="secundario" text="←">
                            <tooltip>
                                <Tooltip text="Volver al listado de candidaturas"/>
                            </tooltip>
                        </Button>
                        <VBox spacing="4.0">
                            <children>
                                <Label fx:id="lblTitulo" styleClass="titulo-pantalla" wrapText="true"/>
                                <Label fx:id="lblSubtitulo" styleClass="subtitulo"/>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblEstado" styleClass="insignia"/>
                        <Button mnemonicParsing="false" onAction="#onEditar" styleClass="secundario" text="Editar"/>
                        <Button mnemonicParsing="false" onAction="#onBorrar" styleClass="peligro" text="Borrar"/>
                    </children>
                </HBox>

                <HBox spacing="18.0">
                    <children>
                        <VBox spacing="18.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="10.0" styleClass="tarjeta">
                                    <children>
                                        <Label styleClass="titulo-tarjeta" text="Datos de la oferta"/>
                                        <GridPane hgap="20.0" vgap="8.0">
                                            <columnConstraints>
                                                <ColumnConstraints minWidth="150.0"/>
                                                <ColumnConstraints hgrow="ALWAYS"/>
                                            </columnConstraints>
                                            <children>
                                                <Label styleClass="etiqueta-dato" text="Puesto"/>
                                                <Label fx:id="lblPuesto" styleClass="valor-dato" wrapText="true" GridPane.columnIndex="1"/>
                                                <Label styleClass="etiqueta-dato" text="Estado" GridPane.rowIndex="1"/>
                                                <Label fx:id="lblEstadoTexto" styleClass="valor-dato" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                                <Label styleClass="etiqueta-dato" text="Fecha de postulación" GridPane.rowIndex="2"/>
                                                <Label fx:id="lblFecha" styleClass="valor-dato,ids-fechas" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                                <Label styleClass="etiqueta-dato" text="Enlace" GridPane.rowIndex="3"/>
                                                <Hyperlink fx:id="lnkEnlace" onAction="#onAbrirEnlace" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                                <Label styleClass="etiqueta-dato" text="Salario" GridPane.rowIndex="4"/>
                                                <Label fx:id="lblSalario" styleClass="valor-dato" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                                            </children>
                                        </GridPane>
                                    </children>
                                </VBox>
                                <VBox spacing="8.0" styleClass="tarjeta">
                                    <children>
                                        <Label styleClass="titulo-tarjeta" text="Descripción"/>
                                        <Label fx:id="lblDescripcion" wrapText="true"/>
                                    </children>
                                </VBox>
                                <VBox spacing="8.0" styleClass="tarjeta">
                                    <children>
                                        <Label styleClass="titulo-tarjeta" text="Notas"/>
                                        <Label fx:id="lblNotas" wrapText="true"/>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox prefWidth="380.0" spacing="18.0">
                            <children>
                                <VBox spacing="10.0" styleClass="tarjeta">
                                    <children>
                                        <Label fx:id="lblEmpresa" styleClass="titulo-tarjeta"/>
                                        <GridPane hgap="20.0" vgap="8.0">
                                            <columnConstraints>
                                                <ColumnConstraints minWidth="90.0"/>
                                                <ColumnConstraints hgrow="ALWAYS"/>
                                            </columnConstraints>
                                            <children>
                                                <Label styleClass="etiqueta-dato" text="Sector"/>
                                                <Label fx:id="lblSector" GridPane.columnIndex="1"/>
                                                <Label styleClass="etiqueta-dato" text="Web" GridPane.rowIndex="1"/>
                                                <Hyperlink fx:id="lnkWeb" onAction="#onAbrirWeb" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                                <Label styleClass="etiqueta-dato" text="Registrada" GridPane.rowIndex="2"/>
                                                <Label fx:id="lblRegistrada" styleClass="ids-fechas" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                            </children>
                                        </GridPane>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
