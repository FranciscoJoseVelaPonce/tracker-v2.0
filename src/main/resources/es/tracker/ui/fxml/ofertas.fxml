<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="pantalla" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="es.tracker.ui.controlador.OfertasControlador">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="titulo-pantalla" text="Candidaturas"/>
                        <Label fx:id="lblResumen" styleClass="subtitulo" text="0 candidaturas"/>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#onImportar" styleClass="secundario" text="Importar CSV">
                    <tooltip>
                        <Tooltip text="Importar candidaturas desde un CSV con el formato de la v1.0"/>
                    </tooltip>
                </Button>
                <Button mnemonicParsing="false" onAction="#onNueva" styleClass="primario" text="+ Nueva candidatura"/>
            </children>
        </HBox>

        <GridPane hgap="14.0" styleClass="tarjeta" vgap="6.0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" percentWidth="34.0"/>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="22.0"/>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="22.0"/>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="22.0"/>
            </columnConstraints>
            <children>
                <Label styleClass="etiqueta-campo" text="Buscar"/>
                <Label styleClass="etiqueta-campo" text="Estado" GridPane.columnIndex="1"/>
                <Label styleClass="etiqueta-campo" text="Empresa" GridPane.columnIndex="2"/>
                <TextField fx:id="txtBuscar" promptText="Título o empresa..." GridPane.rowIndex="1"/>
                <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Todos" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cmbEmpresa" maxWidth="Infinity" promptText="Todas" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onLimpiarFiltros" styleClass="secundario"
                        text="Limpiar filtros" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label styleClass="etiqueta-campo" text="Salario mínimo (€)" GridPane.rowIndex="2"/>
                <Label styleClass="etiqueta-campo" text="Salario máximo (€)" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label styleClass="etiqueta-campo" text="Enviada desde" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <Label styleClass="etiqueta-campo" text="Enviada hasta" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                <TextField fx:id="txtSalarioMin" promptText="Ej.: 18.000" GridPane.rowIndex="3"/>
                <TextField fx:id="txtSalarioMax" promptText="Ej.: 30.000" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <DatePicker fx:id="dpDesde" maxWidth="Infinity" promptText="dd/mm/aaaa" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <DatePicker fx:id="dpHasta" maxWidth="Infinity" promptText="dd/mm/aaaa" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                <Label fx:id="lblErrorFiltro" styleClass="texto-error" GridPane.columnSpan="4" GridPane.rowIndex="4"/>
            </children>
        </GridPane>

        <TableView fx:id="tblOfertas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" styleClass="ids-fechas" text="ID"/>
                <TableColumn fx:id="colTitulo" prefWidth="260.0" text="Título"/>
                <TableColumn fx:id="colEmpresa" prefWidth="160.0" text="Empresa"/>
                <TableColumn fx:id="colEstado" prefWidth="150.0" text="Estado"/>
                <TableColumn fx:id="colFecha" prefWidth="110.0" styleClass="ids-fechas" text="Fecha"/>
                <TableColumn fx:id="colSalario" prefWidth="110.0" text="Salario"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label styleClass="nota-pie" text="Doble clic en una fila para ver el detalle. El estado se cambia desde su desplegable."/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVer" mnemonicParsing="false" onAction="#onVer" styleClass="secundario" text="Ver detalle"/>
                <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#onEditar" styleClass="secundario" text="Editar"/>
                <Button fx:id="btnBorrar" mnemonicParsing="false" onAction="#onBorrar" styleClass="peligro" text="Borrar"/>
            </children>
        </HBox>
    </children>
</VBox>
